              7.85E-6                   0
#                  E                  Nu     Iflag
                 204                  .33         0
#                  a                   b                   n           EPS_p_max            SIG_max0
                1500                 200                  .5                1E30                   0
#                  c           EPS_DOT_0       ICC   Fsmooth               F_cut               Chard
                   0                   0         0         0                   0                   0
#                  m              T_melt              rhoC_p                 T_r
                   0                   0                   0                   0
# /MAT/PLAS_JOHNS/2 — Weldox 460E plate (Borvik 2002 Part II Table 2; cited values)
/MAT/PLAS_JOHNS/2
weldox_460E_plate_candidate
#              RHO_I
              7.85E-6                   0
#                  E                  Nu     Iflag
                 200                  .33         0
#                  a                   b                   n           EPS_p_max            SIG_max0
                 490                 383                 .45                1E30                   0
#                  c           EPS_DOT_0       ICC   Fsmooth               F_cut               Chard
              0.0114                5.E-4         0         0                   0                   0
#                  m              T_melt              rhoC_p                 T_r
                 .94                1800                   0                 293
# /FAIL/JOHNSON/2 — JC damage + element deletion on plate material
#   D1..D5 + EPS_DOT_0 cited from Borvik 2002 Part II Table 2 (Weldox 460E)
#   per ADR-024 (lite). Ifail_sh=2 (shell delete); Ifail_so=1 (solid delete).
#   Tier 1 candidate; not signed validation. Format per OpenRadioss
#   radioss2024 cfg fail_johnson.cfg (no title line; 5x20 + 20+10+10+20+20+10).
/FAIL/JOHNSON/2
#                 D1                  D2                  D3                  D4                  D5
              0.0705               1.732                -.54               -.015                   0
#      EPSILON_DOT_0  IFAIL_SH  IFAIL_SO            EPSF_MIN                DADV               IXFEM
                .001         2         1                   0                   0                    0
