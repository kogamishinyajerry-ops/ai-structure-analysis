# Trigger.dev v4 — get these from https://cloud.trigger.dev (free tier, no card for dev)
# 1) create org + project -> copy the project ref
# 2) API Keys page -> copy the DEV secret key
TRIGGER_PROJECT_REF=proj_xxxxxxxxxxxxxxxx
TRIGGER_SECRET_KEY=tr_dev_xxxxxxxxxxxxxxxx   # SERVER-ONLY. Never in the browser / Vite / Electron renderer.

# Shared secret authenticating this worker -> FastAPI POST /workflow/stage/run.
# MUST equal the backend's TRIGGER_INTERNAL_SECRET (backend .env / Settings).
TRIGGER_INTERNAL_SECRET=choose-a-long-random-string

# Where the Python FEA backend is reachable from the Trigger.dev worker:
FEA_API_BASE=http://localhost:8000/api/v1

# --- Thin trigger server (src/triggerServer.ts) the Monitor calls ---
TRIGGER_SERVER_PORT=3033
# Local-only by default. Bind beyond loopback ONLY behind your own network/auth.
TRIGGER_SERVER_HOST=127.0.0.1
# Optional shared bearer required on POST /trigger-pipeline (X-Trigger-Server-Token).
# Leave empty for a local-only dev box; set a long random string if exposed.
TRIGGER_SERVER_TOKEN=
# CORS origin for the Monitor page. EMPTY by default so no cross-origin browser
# page can read the minted token; set your Monitor's exact origin (e.g.
# http://localhost:5173) only when a browser must call this server (M3).
TRIGGER_SERVER_CORS_ORIGIN=
